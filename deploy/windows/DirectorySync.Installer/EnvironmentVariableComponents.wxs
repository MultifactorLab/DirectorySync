<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        
        <ComponentGroup Id="EnvironmentVariablesComponents">

            <Component Id="EnvApiApiKey" Guid="3BFA871A-23AC-4B30-BA97-C49AD9E93989"
                       Bitness="always64" Directory="INSTALLFOLDER" Condition="PROP_APIKEY">
                <Environment Id="EnvVarMultifactorKey" Name="DIRECTORYSYNC_MULTIFACTOR__KEY"
                             Value="[PROP_APIKEY]" Permanent="no" Part="all" Action="set" System="yes" />
            </Component>

            <Component Id="EnvApiSecret" Guid="AFF037FE-9FF7-4E0F-BEF4-340689A86DBE"
                       Bitness="always64" Directory="INSTALLFOLDER" Condition="PROP_APISECRET">
                <Environment Id="EnvVarMultifactorSecret" Name="DIRECTORYSYNC_MULTIFACTOR__SECRET"
                             Value="[PROP_APISECRET]" Permanent="no" Part="all" Action="set" System="yes" />
            </Component>

            <Component Id="EnvApiUrl" Guid="1AB1B6AC-3976-4CC5-B743-3096F295200A"
                       Bitness="always64" Directory="INSTALLFOLDER" Condition="PROP_APIURL">
                <Environment Id="EnvVarMultifactorUrl" Name="DIRECTORYSYNC_MULTIFACTOR__URL"
                             Value="[PROP_APIURL]" Permanent="no" Part="all" Action="set" System="yes" />
            </Component>

            <Component Id="EnvLdapPath" Guid="8100873D-B0EE-4BEF-BCBB-DD33D71EE5C0"
                       Bitness="always64" Directory="INSTALLFOLDER" Condition="PROP_LDAP_PATH">
                <Environment Id="EnvVarLdapPath" Name="DIRECTORYSYNC_LDAP__PATH"
                             Value="[PROP_LDAP_PATH]" Permanent="no" Part="all" Action="set" System="yes" />
            </Component>

            <Component Id="EnvLdapUsername" Guid="423767AB-2E54-4959-AB80-7999FFCED23F"
                       Bitness="always64" Directory="INSTALLFOLDER" Condition="PROP_LDAP_USERNAME">
                <Environment Id="EnvVarLdapUsername" Name="DIRECTORYSYNC_LDAP__USERNAME"
                             Value="[PROP_LDAP_USERNAME]" Permanent="no" Part="all" Action="set" System="yes" />
            </Component>

            <Component Id="EnvLdapPassword" Guid="5C370873-1EFF-4525-94C5-9B34AD11FEE4"
                       Bitness="always64" Directory="INSTALLFOLDER" Condition="PROP_LDAP_PASSWORD">
                <Environment Id="EnvVarLdapPassword" Name="DIRECTORYSYNC_LDAP__PASSWORD"
                             Value="[PROP_LDAP_PASSWORD]" Permanent="no" Part="all" Action="set" System="yes" />
            </Component>

            <Component Id="EnvLdapAllowCrossDomain" Guid="32E7FD2E-5311-40D9-83F4-5DCF1377582A"
                       Bitness="always64" Directory="INSTALLFOLDER" Condition="PROP_LDAP_ALLOW_CROSS_DOMAIN">
                <Environment Id="EnvVarLdapAllowCrossDomain" Name="DIRECTORYSYNC_LDAP__ALLOWCROSSDOMAINCONNECTIONS"
                             Value="[PROP_LDAP_ALLOW_CROSS_DOMAIN]" Permanent="no" Part="all" Action="set" System="yes" />
            </Component>

        </ComponentGroup>
    </Fragment>
</Wix>