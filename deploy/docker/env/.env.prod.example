# Copy to deploy/docker/env/.env.prod (gitignored) before production compose runs.
# Image is published from GitLab deploy-prod-docker: ${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/${DOCKERHUB_IMAGE}.
# Pin a semver tag in production; avoid relying on :latest.

DIRECTORYSYNC_IMAGE=dtrsec.multifactor.dev/directorysync/directorysync:2.0.0

DIRECTORYSYNC_MULTIFACTOR__URL=https://api.multifactor.ru
DIRECTORYSYNC_MULTIFACTOR__KEY=
DIRECTORYSYNC_MULTIFACTOR__SECRET=

DIRECTORYSYNC_LDAP__PATH=ldaps://ldap.company.local:636
DIRECTORYSYNC_LDAP__USERNAME=
DIRECTORYSYNC_LDAP__PASSWORD=

DIRECTORYSYNC_STORAGE__DIRECTORY=/app/data
DIRECTORYSYNC_STORAGE__LITEDBFILENAME=storage.db

DIRECTORYSYNC_LOGGING__FILE__ENABLED=true
DIRECTORYSYNC_LOGGING__FILE__PATH=/app/logs/log-.txt
DIRECTORYSYNC_LOGGING__CONSOLE__ENABLED=true

DOTNET_ENVIRONMENT=Production
DOTNET_RUNNING_IN_CONTAINER=true
DIRECTORYSYNC_RUNTIME_MODE=Docker
