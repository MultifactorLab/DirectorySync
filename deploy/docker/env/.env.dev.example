# Copy to deploy/docker/env/.env.dev (gitignored) before local compose dev runs.

DIRECTORYSYNC_MULTIFACTOR__URL=https://api.multifactor.ru
DIRECTORYSYNC_MULTIFACTOR__KEY=
DIRECTORYSYNC_MULTIFACTOR__SECRET=

DIRECTORYSYNC_LDAP__PATH=ldaps://ldap.test.local:636
DIRECTORYSYNC_LDAP__USERNAME=
DIRECTORYSYNC_LDAP__PASSWORD=

DIRECTORYSYNC_STORAGE__DIRECTORY=/workspace/data
DIRECTORYSYNC_STORAGE__LITEDBFILENAME=storage.db
DIRECTORYSYNC_LOGGING__FILE__ENABLED=true
DIRECTORYSYNC_LOGGING__FILE__PATH=/workspace/logs/log-.txt
DIRECTORYSYNC_LOGGING__CONSOLE__ENABLED=true

DOTNET_ENVIRONMENT=Development
DOTNET_RUNNING_IN_CONTAINER=true
DIRECTORYSYNC_RUNTIME_MODE=Docker
